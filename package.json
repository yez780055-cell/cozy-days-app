{
  "name": "little-days-app",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/cozy-days-app/ --outDir dist-pages",
    "preview:pages": "vite preview --base=/cozy-days-app/ --outDir dist-pages --host 127.0.0.1 --port 4180 --strictPort",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "cap add android",
    "build:android": "tsc -b && vite build --mode android --outDir dist-android && node scripts/write-web-inventory.mjs dist-android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "test:e2e": "playwright test",
    "test:cloudbase": "playwright test --config playwright.cloudbase.config.ts",
    "test:ci": "node scripts/ci-run.mjs",
    "test:ci:policy": "node --test scripts/ci-plan.test.mjs",
    "test:android:delta": "node scripts/test-android-delta.mjs",
    "test:android:pack": "node scripts/test-android-pack.mjs",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/keyboard": "^7.0.2",
    "dexie": "^4.2.0",
    "lucide-react": "^0.468.0",
    "lunar-typescript": "^1.8.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@electric-sql/pglite": "0.5.17",
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.6.2",
    "vite": "^6.4.5"
  }
}
